{
  "name": "where-they-went",
  "version": "0.1.0",
  "private": true,
  "description": "Where They Went — global forced displacement data platform (UNHCR / IDMC / UN WPP), static, citable, shareable.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "etl": "node scripts/etl/run.ts --out .etl-staging",
    "etl:validate": "node scripts/etl/validate.ts --in .etl-staging",
    "etl:promote": "node scripts/etl/promote.ts",
    "deploy": "node scripts/dev/predeploy.mjs check && npm run build && node scripts/dev/predeploy.mjs stamp && npx wrangler pages deploy dist --project-name wheretheywent",
    "geo": "node scripts/etl/geo/build-geo.ts",
    "validate:data": "node scripts/etl/validate.ts --in public/data/v1",
    "predev": "node scripts/dev/vendor-maplibre.mjs",
    "prebuild": "node scripts/dev/vendor-maplibre.mjs",
    "postinstall": "node scripts/dev/vendor-maplibre.mjs || true"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@observablehq/plot": "0.6.17",
    "astro": "7.2.3",
    "maplibre-gl": "6.4.1",
    "svelte": "5.56.9",
    "topojson-client": "3.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.20.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "i18n-iso-countries": "7.14.0",
    "mapshaper": "0.7.53",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "world-atlas": "2.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "msgpackr-extract@3.0.4": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lakkev/wheretheywent.git"
  },
  "homepage": "https://wheretheywent.lakkev.com"
}
