---
/** Language switcher — a dropdown (7 locales), with plain links as the no-JS fallback. */
import { LOCALES, LOCALE_NAMES, localizePath, stripLocale, useT, type Locale } from '../../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useT(locale);
const base = stripLocale(Astro.url.pathname);
/**
 * Option values carry the target PATH only. The query string cannot be baked in here: these
 * pages are prerendered, so `Astro.url.search` is empty at build time, and the map, country and
 * compare islands rewrite the query with history.replaceState after load. Reading
 * location.search + location.hash at change time is the only way a language switch preserves the
 * view the reader is actually looking at — otherwise switching language silently resets their
 * countries, year and metric, which also breaks the promise that every view is a permanent link.
 */
---

<nav class="lang-switch" aria-label={tr('nav.language')}>
  <label class="visually-hidden" for={`lang-select-${locale}`}>{tr('nav.language')}</label>
  <select id={`lang-select-${locale}`} data-lang-select>
    {
      LOCALES.map((l) => (
        <option value={localizePath(base, l)} selected={l === locale} lang={l}>
          {LOCALE_NAMES[l]}
        </option>
      ))
    }
  </select>
  <noscript>
    {
      LOCALES.map((l) => (
        <a href={localizePath(base, l)} hreflang={l} lang={l}>
          {LOCALE_NAMES[l]}
        </a>
      ))
    }
  </noscript>
</nav>

<script is:inline>
  for (const s of document.querySelectorAll('select[data-lang-select]:not([data-wired])')) {
    s.dataset.wired = '1';
    s.addEventListener('change', function () {
      location.href = this.value + location.search + location.hash;
    });
  }
</script>
