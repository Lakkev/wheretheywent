---
/**
 * /country/[iso3] — true static HTML (citable, indexable). The latest-year summary is rendered
 * server-side; the CountryApp island adds year/metric controls, charts, citation and downloads.
 * The country JSON is inlined via island props (no data request on first paint).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, localizePath, type Locale, type MessageKey } from '../../i18n/ui';
import type { CountryFile } from '../../lib/types';
import { METRIC_IDS } from '../../lib/types';
import { unpack } from '../../lib/columnar';
import {
  getSources,
  getMetrics,
  getManifest,
  getCountries,
  getWorldTotals,
  listDownloads,
  hasOgCard,
  getInsights,
} from '../../lib/data-server';
import { displayName, metricDefinition, zhData } from '../../lib/data';
import { SITE_URL, SITE_NAME } from '../../lib/site';
import { fmtInt, fmtDateLong } from '../../lib/format';
import CountryApp from '../country/CountryApp.svelte';
interface Props {
  locale: Locale;
  iso3: string;
  data: CountryFile;
}
const { locale, iso3, data } = Astro.props;
const tr = useT(locale);
const sources = getSources() ?? {};
const metrics = getMetrics() ?? { schema: 1, metrics: {} as never };
const manifest = getManifest();
const countries = getCountries();
const names: Record<string, string> = {};
for (const c of countries?.countries ?? []) names[c.iso3] = displayName(c, locale);
const name = displayName(data.meta, locale);

/** Quality scorecard: per metric × view — first/last reported, density, longest gap.
 *  Computed from the published series itself (build time), so it can never disagree
 *  with the data it describes. */
interface CovRow {
  m: string;
  v: 'asylum' | 'origin' | 'both';
  first: number;
  firstNZ: number;
  last: number;
  rep: number;
  span: number;
  gap: number;
}
const covRows: CovRow[] = [];
for (const m of METRIC_IDS) {
  const mi = METRIC_IDS.indexOf(m);
  // UNHCR tables zero-fill every metric once a country appears at all, so "first non-null"
  // alone is meaningless. Two honesty rules: (1) years before the metric's global
  // coverage_from count as NOT COLLECTED even when stored as 0 (same rule as the timeline
  // hatch); (2) a metric whose series never goes above zero is omitted entirely.
  const covFrom = metrics.metrics?.[m]?.coverage_from ?? -Infinity;
  const series: Record<'asylum' | 'origin', (number | null)[]> = {
    asylum: unpack(data.asylum.v[mi] ?? []),
    origin: unpack(data.origin.v[mi] ?? []),
  };
  const identical = JSON.stringify(series.asylum) === JSON.stringify(series.origin);
  for (const v of ['asylum', 'origin'] as const) {
    if (identical && v === 'origin') continue;
    const s = series[v];
    let first = -1;
    let firstNZ = -1;
    let last = -1;
    let rep = 0;
    data.years.forEach((y, i) => {
      if (y < covFrom) return;
      const val = s[i];
      if (val !== null && val !== undefined) {
        if (first < 0) first = y;
        if (firstNZ < 0 && val > 0) firstNZ = y;
        last = y;
        rep++;
      }
    });
    if (firstNZ < 0) continue;
    let gap = 0;
    let cur = 0;
    data.years.forEach((y, i) => {
      if (y < Math.max(first, covFrom) || y > last) return;
      const val = s[i];
      if (val === null || val === undefined) {
        cur++;
        gap = Math.max(gap, cur);
      } else cur = 0;
    });
    covRows.push({
      m,
      v: identical ? 'both' : v,
      first,
      firstNZ,
      last,
      rep,
      span: last - first + 1,
      gap,
    });
  }
}
const regionKey = ('region.' + data.meta.region_slug) as Parameters<typeof tr>[0];
const regionLabel = tr(regionKey).startsWith('region.') ? data.meta.region : tr(regionKey);
const yearMax = data.years[data.years.length - 1]!;
const yi = data.years.length - 1;
const latest = METRIC_IDS.map((m, mi) => ({
  m,
  a: unpack(data.asylum.v[mi]!)[yi] ?? null,
  o: unpack(data.origin.v[mi]!)[yi] ?? null,
})).filter((r) => r.a !== null || r.o !== null);
const src = sources['unhcr_population'];
const note = zhData(locale) && data.meta.note_zh ? data.meta.note_zh : data.meta.note;
const pageUrl = `${SITE_URL}${localizePath(`/country/${iso3}`, locale)}`;
const description =
  locale === 'zh-Hant'
    ? `${name}：收容與來源的難民、庇護申請者、境內流離失所者與無國籍者，${data.years[0]}–${yearMax}。來源：UNHCR（資料截至 ${src?.data_as_of ?? ''}）。可下載、可引用。`
    : locale === 'zh-Hans'
      ? `${name}：收容与来源的难民、庇护申请者、境内流离失所者与无国籍者，${data.years[0]}–${yearMax}。来源：UNHCR（数据截至 ${src?.data_as_of ?? ''}）。可下载、可引用。`
      : `${name}: refugees, asylum-seekers, IDPs and stateless persons hosted and originating, ${data.years[0]}–${yearMax}. Source: UNHCR (data as of ${src?.data_as_of ?? ''}). Downloadable, citable.`;
const bulkCsvBytes =
  listDownloads().find((d) => d.name === 'unhcr-population-all-years.csv')?.bytes ?? null;
// Insight engine: up to three context sentences — each mechanically computed, none hand-written.
const insights = getInsights();
const fx = insights?.countries?.[iso3];
const factChips: { text: string; href?: string }[] = [];
if (fx && insights) {
  const iy = insights.year;
  if (fx.per1k_rank && fx.per1k_rank <= 20 && fx.per1k)
    factChips.push({
      text: tr('fact.per1k', { rate: String(fx.per1k), rank: fx.per1k_rank }),
    });
  if (fx.share_of_world_origin && fx.share_of_world_origin >= 0.02)
    factChips.push({
      text: tr('fact.shareOrigin', { pct: `${(fx.share_of_world_origin * 100).toFixed(1)}%` }),
    });
  if (factChips.length < 3 && fx.host_rank && fx.host_rank <= 20)
    factChips.push({ text: tr('fact.hostRank', { rank: fx.host_rank, year: iy }) });
  if (factChips.length < 3 && fx.decade_host_ratio && fx.decade_host_ratio >= 2)
    factChips.push({ text: tr('fact.decadeUp', { x: String(fx.decade_host_ratio) }) });
  else if (factChips.length < 3 && fx.decade_host_ratio && fx.decade_host_ratio <= 0.5)
    factChips.push({
      text: tr('fact.decadeDown', { pct: `${Math.round(fx.decade_host_ratio * 100)}%` }),
    });
  if (factChips.length < 3 && fx.top_dest)
    factChips.push({
      text: tr('fact.topDest', { name: names[fx.top_dest.iso3] ?? fx.top_dest.iso3 }),
      href: localizePath(`/country/${fx.top_dest.iso3}`, locale),
    });
  if (factChips.length < 3 && fx.top_partner)
    factChips.push({
      text: tr('fact.topPartner', { name: names[fx.top_partner.iso3] ?? fx.top_partner.iso3 }),
      href: localizePath(`/country/${fx.top_partner.iso3}`, locale),
    });
  if (factChips.length < 3 && fx.peak_host && fx.peak_host.year !== iy)
    factChips.push({
      text: tr('fact.peak', {
        value: fmtInt(fx.peak_host.value, locale),
        year: fx.peak_host.year,
      }),
    });
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name:
    locale === 'zh-Hant'
      ? `${name} — 被迫流離失所統計 ${data.years[0]}–${yearMax}`
      : locale === 'zh-Hans'
        ? `${name} — 被迫流离失所统计 ${data.years[0]}–${yearMax}`
        : `${name} — forced displacement statistics ${data.years[0]}–${yearMax}`,
  description,
  url: pageUrl,
  identifier: `${SITE_URL}/data/v1/country/${iso3}.json`,
  inLanguage: locale,
  keywords:
    locale === 'zh-Hant'
      ? ['難民', '庇護申請者', '境內流離失所者', '無國籍', 'UNHCR', name]
      : locale === 'zh-Hans'
        ? ['难民', '庇护申请者', '境内流离失所者', '无国籍', 'UNHCR', name]
        : [
            'refugees',
            'asylum seekers',
            'internally displaced persons',
            'statelessness',
            'UNHCR',
            name,
          ],
  datePublished: src?.data_as_of,
  citation: [src?.attribution ?? 'UNHCR Refugee Data Finder'],
  license: src?.license.url ?? 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  /**
   * Upstream sources are cited as CreativeWork, not Dataset. Google's Dataset rich-result
   * validator requires `description` on every node typed Dataset, including nested ones, and we
   * have no description of our own to give for someone else's collection — emitting them as
   * Dataset produced one "missing description" error per source per page (WNC-10030322).
   */
  isBasedOn: Object.values(sources)
    .filter((s) => data.sources.includes(Object.keys(sources).find((k) => sources[k] === s) ?? ''))
    .map((s) => ({
      '@type': 'CreativeWork',
      name: s.title,
      creator: { '@type': 'Organization', name: s.publisher },
      url: s.landing_page,
      license: s.license.url,
    })),
  temporalCoverage: `${data.years[0]}/${yearMax}`,
  spatialCoverage: {
    '@type': 'Place',
    name,
    ...(data.meta.bbox
      ? {
          geo: {
            '@type': 'GeoShape',
            // schema.org box = "south west north east"
            box: `${data.meta.bbox[1]} ${data.meta.bbox[0]} ${data.meta.bbox[3]} ${data.meta.bbox[2]}`,
          },
        }
      : {}),
  },
  dateModified: src?.retrieved_at ?? manifest?.generated_at,
  version: manifest?.snapshot_id,
  variableMeasured: METRIC_IDS.map((m) => ({
    '@type': 'PropertyValue',
    name: tr(`metric.${m}` as MessageKey),
    description: metrics.metrics?.[m] ? metricDefinition(metrics.metrics[m], locale) : '',
  })),
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: `${SITE_URL}/data/v1/country/${iso3}.json`,
      contentSize: `${Buffer.byteLength(JSON.stringify(data))}`,
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: `${SITE_URL}/data/v1/downloads/unhcr-population-all-years.csv`,
      ...(bulkCsvBytes ? { contentSize: `${bulkCsvBytes}` } : {}),
    },
  ],
};
---

<BaseLayout
  title={tr('country.title', { name })}
  description={description}
  locale={locale}
  jsonLd={jsonLd}
  ogImage={hasOgCard(iso3) ? `/og/country/${iso3}.jpg` : undefined}
>
  <article class="doc wide">
    <header class="doc-header">
      <p class="muted small">
        <a href={localizePath('/', locale)}>{tr('nav.map')}</a> › {regionLabel} › {iso3}
      </p>
      <h1>{name}</h1>
      {
        data.meta.name !== data.meta.display_name && (
          <p class="muted small">
            {tr('detail.nameNote', { source: 'UNHCR' })}: {data.meta.name}
          </p>
        )
      }
      {
        note && (
          <p class="callout small">
            {note} <a href={localizePath('/about/boundaries', locale)}>{tr('nav.boundaries')} →</a>
          </p>
        )
      }
      <p class="lede">{tr('country.title', { name })} — {data.years[0]}–{yearMax}.</p>
      {
        factChips.length > 0 && (
          <p class="fact-chips">
            {factChips.map((f) =>
              f.href ? (
                <a class="chip" href={f.href}>
                  {f.text}
                </a>
              ) : (
                <span class="chip">{f.text}</span>
              ),
            )}
          </p>
        )
      }
    </header>

    {/* Static (no-JS) summary for the latest year — crawlers, print, and citation fidelity */}
    <noscript>
      <h2>{tr('country.asOf', { year: yearMax })}</h2>
      {
        latest.length ? (
          <table>
            <thead>
              <tr>
                <>
                  <th>{tr('common.value')}</th>
                  <th class="num">{tr('detail.hosting')}</th>
                  <th class="num">{tr('detail.origin')}</th>
                </>
              </tr>
            </thead>
            <tbody>
              {latest.map((r) => (
                <tr>
                  <td>{tr(`metric.${r.m}` as MessageKey)}</td>
                  <td class="num">{fmtInt(r.a, locale)}</td>
                  <td class="num">{fmtInt(r.o, locale)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="muted">{tr('detail.noData')}</p>
        )
      }
      {
        src && (
          <p class="small muted">
            {tr('source.note', {
              attribution: src.attribution,
              asOf: fmtDateLong(src.data_as_of, locale),
              retrieved: fmtDateLong(src.retrieved_at, locale),
            })}
          </p>
        )
      }
    </noscript>

    <CountryApp
      client:load
      file={data}
      sources={sources}
      metrics={metrics}
      locale={locale}
      names={names}
      siteUrl={SITE_URL}
      snapshotId={manifest?.snapshot_id ?? 'local'}
      worldTotals={getWorldTotals()}
    />

    {/* Quality scorecard — static, crawlable, computed from the published series itself */}
    {
      covRows.length > 0 && (
        <section class="coverage">
          <h2>{tr('cov.title')}</h2>
          <p class="small muted">{tr('cov.lede')}</p>
          <div class="cov-scroll">
            <table class="small">
              <thead>
                <tr>
                  <th>{tr('common.value')}</th>
                  <th>{tr('detail.hosting')} / {tr('detail.origin')}</th>
                  <th class="num">{tr('cov.first')}</th>
                  <th class="num">{tr('cov.firstNZ')}</th>
                  <th class="num">{tr('cov.last')}</th>
                  <th class="num">{tr('cov.density')}</th>
                  <th class="num">{tr('cov.gap')}</th>
                </tr>
              </thead>
              <tbody>
                {covRows.map((r) => (
                  <tr>
                    <td>{tr(`metric.${r.m}` as MessageKey)}</td>
                    <td>
                      {r.v === 'both'
                        ? '—'
                        : r.v === 'asylum'
                          ? tr('detail.hosting')
                          : tr('detail.origin')}
                    </td>
                    <td class="num">{r.first}</td>
                    <td class="num">{r.firstNZ}</td>
                    <td class="num">{r.last}</td>
                    <td class="num">
                      {r.rep}/{r.span}
                    </td>
                    <td class="num">{r.gap > 0 ? tr('cov.gapYears', { n: r.gap }) : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="small muted">{tr('cov.note')}</p>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .cov-scroll {
    overflow-x: auto;
  }
</style>
