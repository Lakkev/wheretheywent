---
/** Generic document page wrapper: header block + slot. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
interface Props {
  locale: Locale;
  title: string;
  lede?: string;
  description?: string;
  wide?: boolean;
  jsonLd?: unknown;
}
const { locale, title, lede, description, wide = false, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description ?? lede} locale={locale} jsonLd={jsonLd}>
  <article class:list={['doc', { wide }]}>
    <header class="doc-header">
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot name="header" />
    </header>
    <slot />
  </article>
</BaseLayout>
