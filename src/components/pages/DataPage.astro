---
/** /data — download centre: bulk CSVs, JSON API-like files, sources & licenses, datapackage. */
import DocPage from './DocPage.astro';
import { useT, localizePath, type Locale } from '../../i18n/ui';
import {
  getManifest,
  getSources,
  getMetrics,
  listDownloads,
  getCountries,
} from '../../lib/data-server';
import { fmtBytes, fmtDateIso } from '../../lib/format';
import { SITE_URL } from '../../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useT(locale);
const manifest = getManifest();
const sources = getSources() ?? {};
const metrics = getMetrics();
const downloads = listDownloads();
const countries = getCountries();
const DESC: Record<string, string> = {
  'unhcr-population-all-years.csv':
    'Long format: one row per country × view × year × metric (non-null only). Best for pandas/R.',
  'unhcr-population-by-asylum.csv':
    'Wide format by country of asylum: one row per country × year, one column per metric.',
  'unhcr-population-by-origin.csv':
    'Wide format by country of origin: one row per country × year, one column per metric.',
  'countries.csv': 'Entity list: ISO3, UNHCR name, display name, region, coverage flags, centroid.',
  'wpp-total-population.csv': 'UN WPP 2024 mid-year total population (per-1,000 denominator).',
};
const zh = locale === 'zh-Hant';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DataCatalog',
  name: 'Where They Went — data downloads',
  url: `${SITE_URL}/data`,
  dataset: downloads.map((d) => ({
    '@type': 'Dataset',
    name: d.name,
    distribution: [
      {
        '@type': 'DataDownload',
        contentUrl: `${SITE_URL}/data/v1/downloads/${d.name}`,
        encodingFormat: 'text/csv',
      },
    ],
  })),
};
---

<DocPage
  locale={locale}
  title={tr('page.data.title')}
  lede={zh
    ? '所有圖表背後的數字皆可下載;每列都帶來源、資料截止日與擷取日。'
    : 'Every number on this site is downloadable. Each row carries its source, as-of date and retrieval date.'}
  wide
  jsonLd={jsonLd}
>
  <section>
    <h2>Bulk CSV</h2>
    <p class="small muted">
      RFC 4180, UTF-8, LF line endings, no comment lines. Empty field = not reported (distinct from
      0). {tr('source.snapshot', { id: manifest?.snapshot_id ?? '—' })}.
    </p>
    <table>
      <thead><tr><th>File</th><th>Description</th><th class="num">Size</th></tr></thead>
      <tbody>
        {
          downloads.map((d) => (
            <tr>
              <>
                <td>
                  <a href={`/data/v1/downloads/${d.name}`} download>
                    {d.name}
                  </a>
                </td>
                <td class="small">{DESC[d.name] ?? ''}</td>
                <td class="num small">{fmtBytes(d.bytes)}</td>
              </>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="small">
      <a href="/data/v1/datapackage.json">datapackage.json</a> (Frictionless Data descriptor with table
      schemas) · <a href="/data/v1/manifest.json">manifest.json</a> (file list, sha256, snapshot id)
    </p>
  </section>

  <section>
    <h2>JSON files (static, CORS-open, versioned)</h2>
    <p class="small">
      There is no API server — everything is a static file under <code>/data/v1/</code>, regenerated
      daily and cached immutably. Fetch with the <code>?v=</code> hash from <code
        >manifest.json</code
      > for instant updates, or without it for the latest.
    </p>
    <table class="small">
      <thead><tr><th>Path</th><th>Contents</th></tr></thead>
      <tbody>
        <tr
          ><td><code>/data/v1/countries.json</code></td><td
            >{countries?.count ?? '—'} entities: ISO3, UNHCR name, display name, region, centroid/bbox,
            coverage flags</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/stock/{'{from}-{to}'}.json</code></td><td
            >Columnar stocks for all metrics × countries × years (both views), population, global
            totals. Zero-runs packed as <code>["z",n]</code>, null-runs as <code>["n",n]</code> (see <code
              >src/lib/columnar.ts</code
            >)</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/country/{'{ISO3}'}.json</code></td><td
            >Everything for one country: series 1951–{manifest?.year_max}, demographics, top
            partners, solutions, asylum applications, IDMC, footnotes</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/flows/{'{year}'}.json</code></td><td
            >Bilateral refugee/asylum-seeker matrix (origin × asylum), 2015+</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/live/nowcast.json</code></td><td
            >UNHCR nowcasting estimates (monthly, labelled as estimates)</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/live/idu-latest.json</code></td><td
            >IDMC Internal Displacement Updates, last 180 days (preliminary)</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/geo/world-50m.topo.json</code></td><td
            >Natural Earth 1:50m boundaries (simplified), ISO3 ids</td
          ></tr
        >
        <tr
          ><td><code>/data/v1/sources.json</code> · <code>/data/v1/metrics.json</code></td><td
            >Provenance, licenses, caveats; metric definitions</td
          ></tr
        >
      </tbody>
    </table>
  </section>

  <section>
    <h2>Sources & licenses</h2>
    <table class="small">
      <thead
        ><tr
          ><th>Source</th><th>License</th><th>Attribution required</th><th>{tr('cite.dataAsOf')}</th
          ><th>{tr('cite.retrieved')}</th><th>Status</th></tr
        ></thead
      >
      <tbody>
        {
          Object.entries(sources).map(([id, s]) => (
            <tr>
              <td>
                <a href={s.landing_page} rel="noopener">
                  {s.publisher}
                </a>{' '}
                — {s.title}
                <br />
                <code class="muted">{id}</code>
              </td>
              <td>
                <a href={s.license.url} rel="noopener">
                  {s.license.id}
                </a>
              </td>
              <td>{s.attribution}</td>
              <td class="num">{fmtDateIso(s.data_as_of)}</td>
              <td class="num">{fmtDateIso(s.retrieved_at)}</td>
              <td>{s.status === 'ok' ? 'ok' : <span class="chip stale">{s.status}</span>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="small">
      Data licence details: <a
        href="https://github.com/Lakkev/wheretheywent/blob/main/DATA-LICENSE.md"
        rel="noopener">DATA-LICENSE.md</a
      >. The site code is all rights reserved; the data remains under its original open licences.
    </p>
  </section>

  <section>
    <h2>Metric definitions</h2>
    <dl class="small">
      {
        Object.values(metrics?.metrics ?? {}).map((m) => (
          <>
            <dt>
              <strong>{m.label}</strong> <code class="muted">{m.id}</code> · source{' '}
              <code>{m.source_id}</code>
            </dt>
            <dd>
              {m.definition}
              {m.caveats.length ? (
                <ul>
                  {m.caveats.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              ) : null}
            </dd>
          </>
        ))
      }
    </dl>
    <p class="small">
      <a href={localizePath('/methodology', locale)}>{tr('nav.methodology')} →</a>
    </p>
  </section>
</DocPage>
