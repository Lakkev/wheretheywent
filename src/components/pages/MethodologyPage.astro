---
import DocPage from './DocPage.astro';
import { useT, localizePath, type Locale, type MessageKey } from '../../i18n/ui';
import { getSources, getManifest, getMetrics } from '../../lib/data-server';
import { metricDefinition, metricCaveats } from '../../lib/data';
import { fmtDateIso } from '../../lib/format';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useT(locale);
const zh = locale === 'zh-Hant' || locale === 'zh-Hans';
const sources = getSources() ?? {};
const manifest = getManifest();
const metrics = getMetrics();
const pop = sources['unhcr_population'];
const metricList = Object.values(metrics?.metrics ?? {}).map((m) => ({
  ...m,
  label_i18n: tr(`metric.${m.id}` as MessageKey),
  def: metricDefinition(m, locale),
  cavs: metricCaveats(m, locale),
}));
---

<DocPage
  locale={locale}
  title={tr('page.methodology.title')}
  lede={zh
    ? '數字如何從 UNHCR、IDMC 與聯合國人口司來到這張地圖 — 以及它們代表什麼、不代表什麼。'
    : 'How the numbers get from UNHCR, IDMC and the UN Population Division onto this map — and what they do and do not mean.'}
>
  <nav class="small muted" aria-label={zh ? '目錄' : 'Contents'}>
    <a href="#sources">{zh ? '資料來源' : 'Sources'}</a> · <a href="#limits"
      >{zh ? '數字的性質' : 'What the numbers are'}</a
    > · <a href="#pipeline">{zh ? '資料管線' : 'Pipeline'}</a> · <a href="#definitions"
      >{zh ? '定義' : 'Definitions'}</a
    > · <a href="#null-vs-zero">{zh ? '未報告≠零' : 'Null vs zero'}</a> · <a href="#views"
      >{zh ? '兩種視角' : 'Two views'}</a
    > · <a href="#per1k">{zh ? '每千人' : 'Per 1,000'}</a> · <a href="#colours"
      >{zh ? '色階' : 'Colour scales'}</a
    > · <a href="#boundaries">{zh ? '邊界' : 'Boundaries'}</a> · <a href="#freshness"
      >{zh ? '更新與故障' : 'Freshness & failure'}</a
    > · <a href="#events">{zh ? '即時事件層' : 'Live events'}</a> · <a href="#cite"
      >{zh ? '引用' : 'Citing'}</a
    >
  </nav>

  <h2 id="sources">1. {zh ? '資料來源' : 'Sources'}</h2>
  <p>
    {
      zh ? (
        <>
          本站呈現的一切都是國際組織公開發布的<strong>群體層級統計</strong>
          。本站永不處理個人層級資料。
        </>
      ) : (
        <>
          Everything shown is <strong>group-level statistics</strong> published by international
          organisations. This site never handles person-level data.
        </>
      )
    }
  </p>
  <table class="small">
    <thead
      ><tr
        ><th>{zh ? '用途' : 'Use'}</th><th>{zh ? '來源' : 'Source'}</th><th
          >{zh ? '端點/檔案' : 'Endpoint / file'}</th
        ><th>{zh ? '授權' : 'License'}</th><th>{zh ? '資料截至' : 'As of'}</th></tr
      ></thead
    >
    <tbody>
      <tr
        ><td
          >{
            zh
              ? '各國歷年存量（難民、庇護申請者、IDP、無國籍者、其他受關注者、回返者、OIP）'
              : 'Stocks by country & year (refugees, asylum-seekers, IDPs, stateless, others of concern, returnees, OIP)'
          }</td
        ><td>UNHCR Refugee Population Statistics Database</td><td
          ><code>api.unhcr.org/population/v1/population/</code>{' '}
          {zh ? '（庇護國、來源國、雙邊矩陣）' : '(asylum, origin, bilateral matrix)'}, <code
            >/footnotes/</code
          ></td
        ><td>{pop?.license.id}</td><td>{fmtDateIso(pop?.data_as_of)}</td></tr
      >
      <tr
        ><td>{zh ? '年齡與性別' : 'Age & sex'}</td><td>UNHCR</td><td
          ><code>/demographics/</code>
          {zh ? '（2010 起，庇護國）' : '(2010+, country of asylum)'}</td
        ><td>CC BY 4.0</td><td>{fmtDateIso(sources['unhcr_demographics']?.data_as_of)}</td></tr
      >
      <tr
        ><td>{zh ? '持久解決方案、庇護申請' : 'Solutions, asylum applications'}</td><td>UNHCR</td
        ><td
          ><code>/solutions/</code> (2000+), <code>/asylum-applications/</code>{' '}
          {zh ? '（2015 起，僅以人數計）' : '(2015+, persons only)'}</td
        ><td>CC BY 4.0</td><td>{fmtDateIso(sources['unhcr_solutions']?.data_as_of)}</td></tr
      >
      <tr
        ><td>{zh ? '境內流離失所（年度存量）' : 'Internal displacement (annual stock)'}</td><td
          >{zh ? 'IDMC（經 UNHCR）' : 'IDMC via UNHCR'}</td
        ><td><code>/idmc/</code> (2009+)</td><td>CC BY-IGO</td><td
          >{fmtDateIso(sources['unhcr_idmc']?.data_as_of)}</td
        ></tr
      >
      <tr
        ><td
          >{
            zh
              ? '近期流離失所事件（延遲 ≤ 24 小時）'
              : 'Recent displacement events (≤ 24 h latency)'
          }</td
        ><td>IDMC Internal Displacement Updates</td><td
          >Helix API{zh ? '，近 180 天' : ', last 180 days'}</td
        ><td>CC BY-IGO</td><td>{fmtDateIso(sources['idmc_idu']?.data_as_of)}</td></tr
      >
      <tr
        ><td>{zh ? '「最新估計」卡片' : 'Latest estimate card'}</td><td
          >{zh ? 'UNHCR 即時推估' : 'UNHCR nowcasting'}</td
        ><td
          ><code>/nowcasting/</code> — {
            zh ? (
              '統計推估，明確標示為估計'
            ) : (
              <>
                statistical <em>estimates</em>, labelled as such
              </>
            )
          }</td
        ><td>CC BY 4.0</td><td>{fmtDateIso(sources['unhcr_nowcasting']?.data_as_of)}</td></tr
      >
      <tr
        ><td>{zh ? '居民人口（每千人分母）' : 'Resident population (per-1,000 denominator)'}</td><td
          >UN DESA World Population Prospects 2024</td
        ><td><code>WPP2024_TotalPopulationBySex.csv</code>{zh ? '，中推計' : ', medium variant'}</td
        ><td>CC BY 3.0 IGO</td><td
          >{fmtDateIso(sources['wpp_population']?.data_as_of)}
          {
            zh
              ? '（估計基準年；其後年份為中推計預測值）'
              : ' (estimates base year; later years are medium-variant projections)'
          }</td
        ></tr
      >
      <tr
        ><td>{zh ? '邊界' : 'Boundaries'}</td><td
          >Natural Earth 1:50m {zh ? '（經 world-atlas）' : '(via world-atlas)'}</td
        ><td>{zh ? '簡化後的 TopoJSON' : 'simplified TopoJSON'}</td><td
          >{zh ? '公有領域' : 'Public domain'}</td
        ><td>—</td></tr
      >
    </tbody>
  </table>
  <p class="small">
    {
      zh ? (
        <>
          各來源的完整出處（端點、內容雜湊、擷取時間、注意事項）以機器可讀形式存於{' '}
          <a href="/data/v1/sources.json">
            <code>sources.json</code>
          </a>
          。未採用：ACLED（授權禁止儀表板再發布）、IOM DTM（授權未確認）、UNHCR Operational Data
          Portal 與微資料（非商業條款）。
        </>
      ) : (
        <>
          Full provenance per source (endpoints, content hashes, retrieval times, caveats) is
          machine-readable in{' '}
          <a href="/data/v1/sources.json">
            <code>sources.json</code>
          </a>
          . Not used: ACLED (licence forbids dashboard republication), IOM DTM (licence not yet
          confirmed), UNHCR Operational Data Portal and microdata (non-commercial terms).
        </>
      )
    }
  </p>

  <h2 id="limits">2. {zh ? '這些數字是什麼、不是什麼' : 'What these numbers are, and are not'}</h2>
  {
    zh ? (
      <ul>
        <li>
          <strong>它們是各國政府與 UNHCR 行動「報告」的數字。</strong>
          國家有高報或低報的誘因——籌款訴求、主權主張、具爭議的法律身分。缺漏不代表沒有流離失所者；灰色不代表零。
        </li>
        <li>
          各國、各年度的涵蓋範圍與定義並不一致；跨年比較請留意定義變動（如 OIP 自 2018 年起）。
        </li>
        <li>IDP 數字僅涵蓋衝突與暴力（IDMC）；年度存量不含災害所致的流離失所。</li>
        <li>即時推估與 IDU 為估計/初步數字，明確標示，永不混入年度序列。</li>
        <li>
          上色需要多邊形：少數統計對象（如馬提尼克、直布羅陀、「無國籍」「來源不明」）沒有可繪製的邊界，列於圖例並仍計入所有總計、表格與下載。
        </li>
        <li>UNHCR 數字不含 UNRWA 職權下的巴勒斯坦難民（約 600 萬），UNRWA 另有統計。</li>
      </ul>
    ) : (
      <ul>
        <li>
          <strong>They are what governments and UNHCR operations report.</strong> States have
          incentives to over- and under-count — funding appeals, sovereignty claims, contested legal
          statuses. A missing figure is not an absence of displaced people; grey is not zero.
        </li>
        <li>
          Coverage and definitions vary by country and year; watch for definition changes when
          comparing across time (e.g. OIP exists only from 2018).
        </li>
        <li>
          IDP figures cover conflict and violence only (IDMC); disaster displacement is not in the
          annual stocks.
        </li>
        <li>
          Nowcast and IDU figures are estimates / preliminary, labelled as such, and never mixed
          into the annual series.
        </li>
        <li>
          Mapping requires a polygon: a few reporting entities (Martinique, Gibraltar, "Stateless",
          "Unknown"…) have no drawable boundary; they are listed in the legend and included in all
          totals, tables and downloads.
        </li>
        <li>
          UNHCR figures exclude Palestine refugees under UNRWA's mandate (about 6 million), counted
          separately by UNRWA.
        </li>
      </ul>
    )
  }

  <h2 id="pipeline">
    3. {zh ? '資料管線：每日、靜態、可稽核' : 'Pipeline: daily, static, audited'}
  </h2>
  {
    zh ? (
      <ol>
        <li>
          <strong>擷取</strong> — 排程作業呼叫 UNHCR API（限流：並發 2、間隔 ≥ 300
          ms、指數退避重試），並下載 WPP CSV 與 IDMC IDU。最新已發布年份自動偵測（目前為{' '}
          {manifest?.year_max}）。
        </li>
        <li>
          <strong>正規化</strong> — 每一列以 <strong>ISO 3166-1 alpha-3</strong>（讀取 UNHCR 的{' '}
          <code>coo_iso</code>/<code>coa_iso</code> 欄位）為鍵。絕不使用 UNHCR 內部碼（
          <code>coo</code>/<code>coa</code>）：它們與真實 ISO3 碰撞（UNHCR
          的「AUS」是奧地利、「ARE」是埃及、「MAR」是馬提尼克）。數值欄位的 <code>"-"</code>
          （未報告）、<code>"0"</code> 與數字分別轉為 <code>null</code> / <code>0</code> / 整數。
        </li>
        <li>
          <strong>驗證</strong> — 發布前須通過 16 條資料不變量（自動化檢查合計 22 項），包括：三組碰撞碼正確歸屬；無負值或非有限值；每個指標、每一年皆滿足
          <em>可上色總和 + 無法顯示總和 = 全球總計</em>；來源國×庇護國雙邊矩陣的行列加總與各國邊際總計一致；年度總計與前一快照差異不超過 20%；三個
          <strong>黃金數字</strong>（土耳其 2024 難民、敘利亞 2016 IDP、全球 2024 難民）誤差須在 1%
          內。
        </li>
        <li>
          <strong>晉升</strong> —
          各來源獨立晉升。任一來源失敗即保留其前一份快照，網站顯示「部分資料更新延遲」；連續三天失敗會寄送告警。
        </li>
        <li>
          <strong>發布</strong> — 資料檔提交至版本控制（逐日稽核軌跡），並按季以束包存入 Zenodo（DOI
          永久公開，任何人可逐位元組驗證歷史快照），再以靜態檔案部署。瀏覽器永不直接呼叫上游 API。
        </li>
      </ol>
    ) : (
      <ol>
        <li>
          <strong>Fetch</strong> — a scheduled job calls the UNHCR API (throttled: 2 concurrent
          requests, ≥ 300 ms apart, retries with back-off) and downloads the WPP CSV and the IDMC
          IDU dump. The latest year with published data is detected automatically (currently{' '}
          {manifest?.year_max}).
        </li>
        <li>
          <strong>Normalise</strong> — every row is keyed by <strong>ISO 3166-1 alpha-3</strong>{' '}
          read from UNHCR's <code>coo_iso</code>/<code>coa_iso</code> fields. UNHCR's internal codes
          (<code>coo</code>/<code>coa</code>) are never used: they collide with real ISO3 codes
          (UNHCR "AUS" is Austria, "ARE" is Egypt, "MAR" is Martinique). Numeric fields arrive as{' '}
          <code>"-"</code> (not reported), <code>"0"</code> or numbers; they are converted to{' '}
          <code>null</code> / <code>0</code> / integer.
        </li>
        <li>
          <strong>Validate</strong> — 16 data invariants (22 automated checks in total) must hold before anything is published,
          including: the three collision cases are keyed correctly; no negative or non-finite
          values; <em>mapped total + unmappable total = global total</em> for every metric and year;
          the origin×asylum bilateral matrix sums back to each country's marginal totals;
          totals do not drift more than 20 % against the previous snapshot; and three{' '}
          <strong>golden numbers</strong> (Türkiye refugees 2024, Syria IDPs 2016, world refugees
          2024) match within 1 %.
        </li>
        <li>
          <strong>Promote</strong> — each source is promoted independently. If a source fails, its
          previous snapshot stays online and the site shows a "partial data update delayed" chip;
          after three consecutive days the maintainer is e-mailed.
        </li>
        <li>
          <strong>Publish</strong> — the data files are committed to version control (a day-by-day
          audit trail) and archived quarterly to Zenodo, where the DOI-addressed bundles let anyone
          verify historical snapshots byte-for-byte; the site is then deployed as static files. The
          browser never calls UNHCR.
        </li>
      </ol>
    )
  }

  <h2 id="definitions">4. {zh ? '定義' : 'Definitions'}</h2>
  <dl>
    {
      metricList.map((m) => (
        <>
          <dt>
            <strong>{m.label_i18n}</strong>
          </dt>
          <dd>
            {m.def}
            {m.cavs.length ? (
              <ul class="small">
                {m.cavs.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            ) : null}
          </dd>
        </>
      ))
    }
  </dl>
  <p>
    {
      zh ? (
        <>
          所有存量皆為<strong>年末（12 月 31 日）</strong>數字；「回返」為年度流量。
        </>
      ) : (
        <>
          All stock figures are <strong>year-end (31 December)</strong>. "Returned" figures are
          flows during the year.
        </>
      )
    }
  </p>

  <h2 id="null-vs-zero">5. {zh ? '未報告不等於零' : 'Null is not zero'}</h2>
  <p>
    {
      zh ? (
        <>
          UNHCR 區分<em>未報告</em>（<code>"-"</code>）與<em>報告為零</em>
          。本站全程保留這個區別：地圖上（灰色 vs 最淺的沙色）、圖表中（折線中斷 vs
          落到零）、CSV（空欄位 vs <code>0</code>）與 JSON（<code>null</code> vs <code>0</code>
          ）。灰色國家可能收容許多流離失所者，只是該年度未報告。
        </>
      ) : (
        <>
          UNHCR distinguishes <em>not reported</em> (<code>"-"</code>) from <em>reported zero</em>.
          We keep that distinction everywhere: on the map (grey vs the lightest sand), in charts (a
          gap in the line vs a point at 0), in CSV (empty field vs <code>0</code>) and in JSON (
          <code>null</code> vs <code>0</code>). A country in grey may host many displaced people
          whose figures simply were not reported that year.
        </>
      )
    }
  </p>

  <h2 id="views">
    6. {zh ? '兩種視角：現居地與來源地' : 'Two views: where they are, where they fled from'}
  </h2>
  <p>
    {
      zh ? (
        <>
          每個數字都有兩種地理歸屬。<strong>庇護國</strong>
          （「他們現在在哪裡」）按人們目前所在的國家計數；<strong>來源國</strong>
          （「他們從哪裡逃離」）按人們離開的國家計數。境內流離失所者在兩種視角中都計入其本國。「流向」分頁與{' '}
          <code>flows/</code> 檔案提供雙邊矩陣。
        </>
      ) : (
        <>
          Every figure has two geographies. <strong>Country of asylum</strong> ("where they are
          now") counts people where they currently live. <strong>Country of origin</strong> ("where
          they fled from") counts the same people by the country they left. Internally displaced
          persons are counted in their own country in both views. The "Flows" tab and the{' '}
          <code>flows/</code> files give the bilateral matrix.
        </>
      )
    }
  </p>

  <h2 id="per1k">7. {zh ? '每千人' : 'Per 1,000 residents'}</h2>
  <p>
    {
      zh ? (
        <>
          比率 = 人數 ÷ UN WPP 年中總人口 × 1,000。兩點注意：分子是 12 月 31 日的存量、分母是 7 月 1
          日的人口；WPP 估計基準年之後的年份為中推計預測值。缺人口資料時不顯示比率。
        </>
      ) : (
        <>
          Rate = persons ÷ UN WPP mid-year total population × 1,000. Two caveats: the numerator is a
          31 December stock while the denominator is 1 July; and WPP values after the estimate base
          year are medium-variant projections. Rates are not shown where population is missing.
        </>
      )
    }
  </p>

  <h2 id="colours">8. {zh ? '色階' : 'Colour scales'}</h2>
  <p>
    {
      zh ? (
        <>
          全站使用<strong>大地色連續色階</strong>（ColorBrewer
          YlOrBr：沙 → 赭 →
          耕土的深褐），七個級距，色盲友善。原則不變：<strong>不把流離失所者在視覺上呈現為「威脅」</strong>
          ——因此全站刻意沒有任何紅色，最深一級是土壤的褐，而非警報色；流向也以弧線而非箭頭呈現。選擇大地色是一個明確的設計主張：荒漠與土壤，是人們所跨越、也所失去的東西。此設計於
          2026-08-25 取代早期版本的單色藍階（變更有紀錄可查），並由自動化測試守護：色階必須為暖土色系、逐級變暗，任何改為警報紅的嘗試都會使建置失敗。分級預設為
          <strong>分位數</strong>
          ，且<strong>跨全部年份</strong>
          計算（針對目前顯示的國家）：拖動時間軸時顏色代表「量級」而非每年重排的「名次」，不同年份的截圖可以互相比較。零有自己的最淺色；未報告為灰色。
        </>
      ) : (
        <>
          The site uses an <strong>earth-tone sequential ramp</strong> (ColorBrewer YlOrBr: sand →
          ochre → tilled-soil brown), seven classes, colour-blind safe. The principle is unchanged:{' '}
          <strong>displaced people are never visually framed as a threat</strong> — the site
          deliberately contains no red anywhere; the deepest class is the brown of soil, not an
          alarm colour, and flows are drawn as arcs, not arrows. The earth palette is a deliberate
          statement: desert and soil are what people cross, and what they lose. This design
          replaced an earlier single-hue blue ramp on 2026-08-25 (the change is on record), and is
          guarded by automated tests: the ramp must be warm-earth and monotonically darkening — any
          attempt to switch to alarm red fails the build. Default breaks are{' '}
          <strong>quantiles computed across the whole year range</strong> for the countries shown:
          while you scrub the timeline, colour means magnitude, not a rank that reshuffles every
          year — so screenshots from different years are comparable. Zero has its own lightest
          colour; not-reported is grey.
        </>
      )
    }
  </p>

  <h2 id="boundaries">9. {zh ? '邊界與名稱' : 'Boundaries and names'}</h2>
  <p>
    {
      zh ? (
        <>
          邊界取自 Natural
          Earth，經簡化以利顯示。國名跟隨被引用的資料來源（UNHCR），另有小型覆寫表以利閱讀（如「Syrian
          Arab Rep.」→「敘利亞」）；原始名稱一律並列。爭議地區、科索沃與台灣皆有明確處理——詳見
          <a href={localizePath('/about/boundaries', locale)}>邊界、名稱與爭議地區</a>。
        </>
      ) : (
        <>
          Boundaries come from Natural Earth, simplified for display. Country names follow the data
          source being cited (UNHCR), with a small override table for readability (e.g. "Syrian Arab
          Rep." → "Syria"); the original name is always shown alongside. Disputed territories,
          Kosovo and Taiwan are handled explicitly — see{' '}
          <a href={localizePath('/about/boundaries', locale)}>
            Boundaries, names and disputed territories
          </a>
          .
        </>
      )
    }
  </p>

  <h2 id="freshness">10. {zh ? '更新頻率與故障處理' : 'Freshness and failure'}</h2>
  <p>
    {
      zh ? (
        <>
          UNHCR 約在每年 6 月發布上年度數字、10/11
          月發布年中數字。管線每日執行，但只在內容變動時提交。三種時間戳嚴格分開：
          <code>data_as_of</code>（資料涵蓋到哪天）、<code>retrieved_at</code>
          （我們何時擷取——只在內容變動時前進）、資料集快照
          <code>snapshot_id</code>（整份資料的內容雜湊，目前為 <code>{manifest?.snapshot_id}</code>
          ）。大宗 CSV 的 <code>snapshot_id</code> 欄位帶的是母體來源的內容雜湊前 8 碼，可經{' '}
          <code>sources.json</code> 回溯驗證。
        </>
      ) : (
        <>
          UNHCR publishes annual figures around June and mid-year figures around October/November.
          The pipeline runs daily but only commits when content changes. Three timestamps are kept
          apart: <code>data_as_of</code> (what the data covers), <code>retrieved_at</code> (when we
          fetched it — only advances when content changed) and the dataset <code>snapshot_id</code>{' '}
          (content hash of the whole dataset, currently <code>{manifest?.snapshot_id}</code>). The
          bulk CSVs carry the population source's content-hash prefix in their snapshot column,
          resolvable via <code>sources.json</code>.
        </>
      )
    }
  </p>

  <h2 id="events">11. {zh ? '即時事件層的處理原則' : 'The live events layer'}</h2>
  <p>
    {
      zh ? (
        <>
          「近期境內流離失所事件」層轉載 IDMC 的初步事件估計。基於尊嚴與安全考量：
          <strong>衝突</strong>事件的座標一律對齊約 25 公里的網格（絕不標示到聚落層級）；少於 100
          人的事件不單獨繪點；彈窗顯示數字、類型與日期，並連往 IDMC
          的原始報告，而非轉貼敘述文字。此層的事件定義與年度 IDP 存量不同（後者不含災害）。
        </>
      ) : (
        <>
          The "recent internal displacement events" layer republishes IDMC's preliminary event-level
          estimates. For dignity and safety: coordinates of <strong>conflict</strong> events are
          snapped to a ~25 km grid (never settlement-level); events under 100 people are not drawn
          as individual points; the popup shows figure, type and date and links to IDMC's own report
          instead of pasting narrative text. Event definitions differ from the annual IDP stock
          (which excludes disasters).
        </>
      )
    }
  </p>

  <h2 id="cite">12. {zh ? '引用' : 'Citing'}</h2>
  <p>
    {
      zh ? (
        <>
          每個檢視都有固定連結，可重現年份、指標、視角、篩選、選取國家與地圖位置（分享與引用產生的連結會固定年份）。「引用」按鈕提供
          APA 7、芝加哥（作者–年份）、BibTeX（<code>@dataset</code>，含 <code>version</code>
          ）與「引用本頁」四種格式；出版年份採用<strong>資料年份</strong>
          而非點閱年份，並附上資料快照代碼以利精確回溯。請同時引用上游來源。
        </>
      ) : (
        <>
          Every view has a permanent link that reproduces year, metric, view, filters, selection and
          map position (links produced by Share/Cite pin the year). The "Cite" button gives APA 7,
          Chicago (author–date), BibTeX (<code>@dataset</code> with <code>version</code>) and a
          plain "cite this page" string; the publication year is the <strong>data year</strong>, not
          the year you clicked, and the snapshot id is included for exact recovery. Please cite the
          upstream source as well as this site.
        </>
      )
    }
  </p>
