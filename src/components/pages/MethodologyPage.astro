---
import DocPage from './DocPage.astro';
import { useT, type Locale } from '../../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useT(locale);
---

<DocPage locale={locale} title={tr('page.methodology.title')}>
  <p class="muted">Methodology (batch ⑤).</p>
</DocPage>
