---
import DocPage from './DocPage.astro';
import { localizePath, useT, type Locale } from '../../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useT(locale);
---

<DocPage locale={locale} title={tr('page.notFound.title')}>
  <p>{tr('page.notFound.body')}</p>
  <p><a href={localizePath('/', locale)}>{tr('nav.map')}</a></p>
</DocPage>
