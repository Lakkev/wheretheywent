---
import DocPage from './DocPage.astro';
import CompareApp from '../country/CompareApp.svelte';
import { useT, type Locale } from '../../i18n/ui';
import { SITE_URL } from '../../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = useT(locale);
---

<DocPage
  locale={locale}
  title={tr('compare.title')}
  lede={tr('compare.max')}
  description={tr('page.compare.desc')}
  wide
>
  <CompareApp client:load locale={locale} siteUrl={SITE_URL} />
</DocPage>
