---
/**
 * BaseLayout — document-style pages (country, compare, methodology, data, about…).
 * Provides: <head> meta, hreflang alternates, JSON-LD slot, skip link, header nav, footer.
 */
import '../styles/global.css';
import { LOCALES, localeFromPath, localizePath, stripLocale, useT, type Locale } from '../i18n/ui';
import { SITE_URL, SITE_NAME, CONTACT_EMAIL } from '../lib/site';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** JSON-LD object(s) to embed. */
  jsonLd?: unknown;
  /** Hide header/footer (e.g. for fullscreen map). */
  bare?: boolean;
  bodyClass?: string;
  noindex?: boolean;
  /** Page-specific og:image path (site-relative); defaults to the shared map card. */
  ogImage?: string;
}

const {
  title,
  description,
  jsonLd,
  bare = false,
  bodyClass = '',
  noindex = false,
  ogImage: ogImagePath,
} = Astro.props;
const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const tr = useT(locale);
const desc = description ?? tr('site.description');
const path = Astro.url.pathname;
const base = stripLocale(path);
const canonical = `${SITE_URL}${localizePath(base, locale)}`;
const alternates = LOCALES.map((l) => ({ l, href: `${SITE_URL}${localizePath(base, l)}` }));
const htmlLang = locale;
const OG_LOCALE: Record<Locale, string> = {
  en: 'en_US',
  'zh-Hant': 'zh_TW',
  'zh-Hans': 'zh_CN',
  fr: 'fr_FR',
  es: 'es_ES',
  ja: 'ja_JP',
  ko: 'ko_KR',
};
const brand = tr('site.name');
// The home page gets a descriptive title — a brand nobody has heard of yet is zero signal in search.
const fullTitle =
  title === brand || title === SITE_NAME
    ? `${brand} — ${tr('site.titleTag')}`
    : `${title} · ${brand}`;
const ogImage = `${SITE_URL}${ogImagePath ?? '/og/default.png'}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={tr('site.ogAlt')} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#1f5fa8" />
    <meta name="contact" content={CONTACT_EMAIL} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{tr('nav.skip')}</a>
    {!bare && <SiteHeader locale={locale} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <SiteFooter locale={locale} />}
  </body>
</html>
