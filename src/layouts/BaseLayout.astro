---
/**
 * BaseLayout — document-style pages (country, compare, methodology, data, about…).
 * Provides: <head> meta, hreflang alternates, JSON-LD slot, skip link, header nav, footer.
 */
import '../styles/global.css';
import { localeFromPath, localizePath, stripLocale, useT, type Locale } from '../i18n/ui';
import { SITE_URL, SITE_NAME, CONTACT_EMAIL } from '../lib/site';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** JSON-LD object(s) to embed. */
  jsonLd?: unknown;
  /** Hide header/footer (e.g. for fullscreen map). */
  bare?: boolean;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, jsonLd, bare = false, bodyClass = '', noindex = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const tr = useT(locale);
const desc = description ?? tr('site.description');
const path = Astro.url.pathname;
const base = stripLocale(path);
const canonical = `${SITE_URL}${localizePath(base, locale)}`;
const altEn = `${SITE_URL}${localizePath(base, 'en')}`;
const altZh = `${SITE_URL}${localizePath(base, 'zh-Hant')}`;
const htmlLang = locale === 'zh-Hant' ? 'zh-Hant' : 'en';
const brand = tr('site.name');
const fullTitle = title === brand || title === SITE_NAME ? brand : `${title} · ${brand}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="zh-Hant" href={altZh} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1f5fa8" />
    <meta name="contact" content={CONTACT_EMAIL} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{tr('nav.skip')}</a>
    {!bare && <SiteHeader locale={locale} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <SiteFooter locale={locale} />}
  </body>
</html>
