returned_refugees":null,"resettlement":57,"naturalisation":null,"returned_idps":null},{"year":2023,"returned_refugees":null,"resettlement":13,"naturalisation":null,"returned_idps":null},{"year":2024,"returned_refugees":null,"resettlement":6,"naturalisation":null,"returned_idps":null},{"year":2025,"returned_refugees":null,"resettlement":5,"naturalisation":null,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":338},{"year":2016,"applied":1089},{"year":2017,"applied":1681},{"year":2018,"applied":1256},{"year":2019,"applied":1489},{"year":2020,"applied":1018},{"year":2021,"applied":1409},{"year":2022,"applied":5093},{"year":2023,"applied":5246},{"year":2024,"applied":3623},{"year":2025,"applied":2124}],"origin":[{"year":2018,"applied":5},{"year":2019,"applied":5},{"year":2021,"applied":5},{"year":2022,"applied":5}]},"idmc":[],"footnotes":[{"year":2023,"population_type":"RST","text":"The number of resettlement arrivals is based on available figures of UNHCR facilitated resettlement departures to Iceland.","view":"asylum"},{"year":2023,"population_type":"STA","text":"The decrease in the stateless population in Iceland between 2022 and 2023 is due to de-duplication of figures reported in previous years.","view":"asylum"},{"year":2024,"population_type":"REF","text":"With regards to refugee statistics, since 2024 the number of refugees in Iceland are based on data reported by authorities of persons with valid residence permits issued on the basis of international protection, subsidiary protection, resettlement or family reasons and adding beneficiaries of temporary protection. It does not include refugees who have been granted permanent residence permits. The figures replace previous refugee stock estimations conducted by UNHCR.","view":"asylum"},{"year":2024,"population_type":"STA","text":"With regards to stateless statistics, the figures include: (a) the number of stateless asylum seekers at end-year as reported by the Icelandic authorities; (b) the number of stateless refugees at year-end with valid residence permits on the basis of international protection as reported by Icelandic authorities; and (c) the number of non-displaced stateless persons (those with other non-protection related types of permits) based on data from Statistics Iceland corresponding to the resident population recorded as \"Stateless\" as of 1 January 2024 (no available data for end-2024 yet), deducting the reported number of stateless refugees at year-end.","view":"asylum"},{"year":2025,"population_type":"REF","text":"With regards to refugee statistics, since 2024 the number of refugees in Iceland are based on data reported by authorities of persons with valid residence permits issued on the basis of international protection, subsidiary protection, resettlement or family reasons and adding beneficiaries of temporary protection. It does not include refugees who have been granted permanent residence permits.","view":"asylum"},{"year":2025,"population_type":"STA","text":"With regards to stateless statistics, the figures include:  (a) the number of stateless asylum seekers at year-end as reported by the Icelandic authorities; (b) the number of stateless refugees at year-end with valid residence permits on the basis of international protection as reported by Icelandic authorities; and (c) the number of non-displaced stateless persons (those with other non-protection related types of permits) based on data from Statistics Iceland corresponding to the resident population recorded as \"Stateless\" as of 1 January 2025 (no data is available yet for end-2025), deducting the reported number of stateless refugees at year-end.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
