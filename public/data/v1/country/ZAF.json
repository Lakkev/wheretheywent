esettlement":null,"naturalisation":null,"returned_idps":null},{"year":2023,"returned_refugees":347,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2024,"returned_refugees":317,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2025,"returned_refugees":337,"resettlement":null,"naturalisation":null,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":120479},{"year":2016,"applied":35349},{"year":2017,"applied":24162},{"year":2018,"applied":16125},{"year":2019,"applied":48366},{"year":2020,"applied":3074},{"year":2022,"applied":8754},{"year":2023,"applied":20442},{"year":2024,"applied":7077},{"year":2025,"applied":5324}],"origin":[{"year":2015,"applied":737},{"year":2016,"applied":547},{"year":2017,"applied":784},{"year":2018,"applied":1249},{"year":2019,"applied":1696},{"year":2020,"applied":805},{"year":2021,"applied":592},{"year":2022,"applied":1373},{"year":2023,"applied":2356},{"year":2024,"applied":2315},{"year":2025,"applied":1363}]},"idmc":[{"year":2023,"total":620},{"year":2024,"total":29}],"footnotes":[{"year":2015,"population_type":"ASY","text":"An adjustment to 2015 end of year figures, in particular for the number of asylum applications pending on appeal and review, has resulted in a substantially lower figure for numbers of asylum-seekers reported in South Africa.","view":"asylum"},{"year":2015,"population_type":"ASY","text":"An adjustment to 2014 end of year figures in particular for the number of asylum applications pending on appeal and review has resulted in a substantially higher figure for numbers of asylum seekers reported in South Africa for 2015. It should be noted that the current legal framework in South Africa does not enable the withdrawal (whether explicit or implicit) of asylum applications lodged.","view":"asylum"},{"year":2016,"population_type":"ASY","text":"An adjustment to 2016 end of year figures, in particular for the number of asylum applications pending on appeal and review, has resulted in a substantially lower figure for numbers of asylum-seekers reported in South Africa.","view":"asylum"},{"year":2018,"population_type":"ASY","text":"All figures refer to the mid of 2018.","view":"asylum"},{"year":2018,"population_type":"ASY","text":"All figures refer to mid-2018.","view":"asylum"},{"year":2018,"population_type":"REF","text":"The figure related to the mid of 2018.","view":"asylum"},{"year":2018,"population_type":"REF,ROC,ASY,IDP,IOC,STA,OOC,RET,RDP,HST,OIP,RST,NAT","text":"All figures related to mid-2018.","view":"asylum"},{"year":2019,"population_type":"REF","text":"The total number of refugees is 78,398 at the end of 2019. The numbers published refer to end-2018, as validated disaggregated country of origin data for 2019 was not available at time of publication.","view":"asylum"},{"year":2021,"population_type":"ASY","text":"New asylum applications were not received in 2021 while Refugee Reception Offices were closed due to the declaration of a national state of disaster (COVID-19 health pandemic).","view":"asylum"},{"year":2022,"population_type":"REF,ROC,ASY,IDP,IOC,STA,OOC,RET,RDP,HST,OIP,RST,NAT","text":"In South Africa, all refugees and asylum-seekers with valid permits were considered to be active during the COVID-19 pandemic era as long as their permit’s expiry dates were after the breakout of the pandemic. With the resumption of normal services in 2022, many permits have been inactivated and are therefore considered to be administrative closures.  In total, some 72,200 individuals either did not extend their permits or the extended permits became inactive by the end of the year. Individuals whose permits have been inactivated can reapply although asylum-seekers and refugees have reported challenges in accessing the online renewal system.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
