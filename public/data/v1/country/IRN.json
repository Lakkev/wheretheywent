_idps":null},{"year":2009,"returned_refugees":11648,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2010,"returned_refugees":10168,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2011,"returned_refugees":36866,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2012,"returned_refugees":21890,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2013,"returned_refugees":12282,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2014,"returned_refugees":4793,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2015,"returned_refugees":4152,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2016,"returned_refugees":2426,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2017,"returned_refugees":1479,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2018,"returned_refugees":1984,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2019,"returned_refugees":2009,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2020,"returned_refugees":947,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2021,"returned_refugees":879,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2022,"returned_refugees":538,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2023,"returned_refugees":521,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2024,"returned_refugees":237452,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2025,"returned_refugees":1386970,"resettlement":null,"naturalisation":null,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":5},{"year":2016,"applied":85}],"origin":[{"year":2015,"applied":44834},{"year":2016,"applied":65655},{"year":2017,"applied":40100},{"year":2018,"applied":49833},{"year":2019,"applied":37154},{"year":2020,"applied":18849},{"year":2021,"applied":27674},{"year":2022,"applied":36473},{"year":2023,"applied":44586},{"year":2024,"applied":35038},{"year":2025,"applied":35295}]},"idmc":[],"footnotes":[{"year":null,"population_type":"STA","text":"No estimates of the entire stateless population in the Islamic Rep. of Iran is available.","view":"asylum"},{"year":2020,"population_type":"REF","text":"In October 2020, UNHCR Iran received the data on total number of refugees from the Government of the Islamic Republic of Iran, on which consultations are ongoing. According to it, 800,000 refugee card holders reside in the Islamic Republic of Iran, 780,000 of whom are Afghans and 20,000 Iraqis. The last time the Iranian Government had shared information on Afghan refugee population was in May 2015, when according to it 951,410 Afghan refugees resided in Iran; the Iraqi refugee population data was shared in 2013, and according to it 28,268 Iraqi refugees resided in Iran. UNHCR is in consultations with the authorities to understand the reasons behind the decrease reported in 2020 data (170,081 for Afghan refugees and 8,268 for Iraqi refugees).","view":"asylum"},{"year":2020,"population_type":"STA","text":"The figures reported reflects stateless persons of Rohingya ethnicity who are also counted as refugees from Myanmar, mainly from Rakhine State. UNHCR’s statistical reporting generally follows a methodology that reports only one legal status for each person of concern. However, due to the size of the stateless Rohingya population displaced from Myanmar, UNHCR considers it important to reflect the dual status of this population group as both displaced and stateless. The figure reflected does not represent an estimation of the entire stateless population.","view":"asylum"},{"year":2021,"population_type":"REF","text":"This includes around 770,500 refugees and 27,800 UNHCR pre-registered new arrivals, reported as refugee-like. Based on information received from the Government in October 2020, the Islamic Republic of Iran hosts 800,000 refugees, of which 780,000 are Afghan Amayesh cardholders and 20,000 are Iraqi Hoviat cardholders. These cards effectively offer refugee status to their holders. UNHCR has been in continuous engagement with the authorities in relation to these figures ever since. In view of the absence of updated data, UNHCR sought to estimate the changes in the refugee population considering the natural growth and onward movements, estimating the total to be some 770,000 refugees (out of which 750,000 were Afghans and 20,000 Iraqis).","view":"asylum"},{"year":2021,"population_type":"STA","text":"The figures reported reflects stateless persons of Rohingya ethnicity who are also counted as refugees from Myanmar, mainly from Rakhine State.  The figure reflected does not represent an estimation of the entire stateless population.","view":"asylum"},{"year":2022,"population_type":"REF","text":"In the Islamic Republic of Iran, some 2.6 million Afghans have been reported as people in a refugee-like situation. In 2022, the Government of the Islamic Republic of Iran conducted a recount of the previously \"head counted\" population and extended the scope of this scheme to all undocumented Afghans residing in the country, including those who had newly arrived due to the Taliban takeover in 2021 in Afghanistan. It is reported that 2.6 million Afghans enrolled in this exercise, which provides them with a headcount slip and temporary protection from deportation.","view":"asylum"},{"year":2023,"population_type":"STA","text":"Stateless refugees from Myanmar of Rohingya ethnicity in Iran have been resettled in 2023. No estimates of the entire stateless population in the Islamic Rep. of Iran is available.","view":"asylum"},{"year":2024,"population_type":"REF","text":"From the Islamic Republic of Iran, almost a quarter of a million Afghans were estimated to have returned to their country in 2024. Refugee returns are expected to increase in 2025, following the announcement by the Government of the Islamic Republic of Iran in February 2025 that headcount slips will not be extended beyond 20 March 2025. See https://data.unhcr.org/en/documents/details/115667.","view":"asylum"},{"year":2025,"population_type":"REF","text":"At end-2025, 1 million Afghans were, for the first time, reported as other people in need of international protection in five countries. Previously, these Afghans had been reported as people in a refugee-like situation. The reclassification includes some 879,500 people in the Islamic Republic of Iran who are Movaqat holders, family passport holders or former headcount slip holders and an estimated population of undocumented Afghans.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
