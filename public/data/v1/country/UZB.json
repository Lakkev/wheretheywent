ned_refugees":5,"resettlement":38,"naturalisation":72,"returned_idps":null},{"year":2025,"returned_refugees":10,"resettlement":null,"naturalisation":57,"returned_idps":null}],"solutions_host":[{"year":2002,"returned_refugees":93,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2003,"returned_refugees":117,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2004,"returned_refugees":69,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2005,"returned_refugees":5,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2008,"returned_refugees":21,"resettlement":null,"naturalisation":null,"returned_idps":null}],"asylum_applications":{"host":[],"origin":[{"year":2015,"applied":1369},{"year":2016,"applied":1532},{"year":2017,"applied":1401},{"year":2018,"applied":2533},{"year":2019,"applied":2757},{"year":2020,"applied":2714},{"year":2021,"applied":2246},{"year":2022,"applied":6759},{"year":2023,"applied":14868},{"year":2024,"applied":10479},{"year":2025,"applied":4666}]},"idmc":[{"year":2009,"total":3400},{"year":2010,"total":3400},{"year":2011,"total":3400},{"year":2012,"total":3400},{"year":2013,"total":3400},{"year":2014,"total":3400}],"footnotes":[{"year":2015,"population_type":"STA","text":"Figure refers to stateless persons with permanent residence reported by the Government in 2010. Information on other categories of stateless persons is not available.","view":"asylum"},{"year":2015,"population_type":"STA","text":"Figure of stateless persons refers to those with permanent residence reported in 2010 by the Government. Information on other categories of stateless persons is not available.","view":"asylum"},{"year":2016,"population_type":"STA","text":"The statelessness figure refers to stateless persons with permanent residence reported by the Government in 2010. The figure has been adjusted to reflect the acquisition of nationality of 179 formerly stateless persons. Information on other categories of stateless persons is not available.","view":"asylum"},{"year":2016,"population_type":"STA","text":"Figure refers to stateless persons with permanent residence reported by the Government in 2010. The figure has been adjusted to reflect the acquisition of nationality of 179 formerly stateless persons. Information on other categories of stateless persons is not available.","view":"asylum"},{"year":2017,"population_type":"STA","text":"In 2010, the Government reported 86,703 stateless persons with permanent residence. The figure has been adjusted provided that citizenship of Uzbekistan was granted to 1,148 persons since December 2016. Information on other categories of stateless persons is not available.","view":"asylum"},{"year":2017,"population_type":"STA","text":"The statelessness figure refers to stateless persons with permanent residence reported by the Government in 2010. The figure has been adjusted provided that citizenship of Uzbekistan was granted to 1,148 persons since December 2016. Information on other categories of stateless persons is not available.","view":"asylum"},{"year":2018,"population_type":"STA","text":"The statelessness figure refers to stateless persons with permanent residence reported by the Government of Uzbekistan in 2010. The figure has been adjusted to reflect that citizenship of Uzbekistan has been granted to 6,761 persons since December 2016.","view":"asylum"},{"year":2019,"population_type":"STA","text":"The statelessness figure refers to stateless persons with permanent residence reported by the Government of Uzbekistan in December 2019 under the XII Report on compliance of Uzbekistan with CERD. Information on other categories of statelessness is unavailable.","view":"asylum"},{"year":2020,"population_type":"STA","text":"The statelessness figure refers to stateless persons with permanent residence reported by the Government of Uzbekistan in November 2020 under the XII Report on compliance of Uzbekistan with CERD. Information on other categories of statelessness is unavailable.","view":"asylum"},{"year":2021,"population_type":"STA","text":"The 2021 end-year statelessness figure refers to stateless persons with permanent residence in Uzbekistan officially reported by the Government of Uzbekistan to UNHCR as of 31 December 2021. Information on other categories of statelessness is unavailable. The reported figure includes a reduction of 2,200 people who acquired the citizenship of Uzbekistan from 1 to 31 December 2020, which was not included in the 2020 annual statistics as it was reported in February 2022.","view":"asylum"},{"year":2022,"population_type":"STA","text":"The 2022 statelessness figure refers to stateless persons with permanent residence in Uzbekistan officially reported by the Government of Uzbekistan to UNHCR as of 31 December 2022. Information on other categories of statelessness is unavailable.","view":"asylum"},{"year":2023,"population_type":"STA","text":"The statelessness figure refers to stateless persons with permanent residence in Uzbekistan officially reported by the Government of Uzbekistan to UNHCR as of 31 December 2023. Information on other categories of statelessness is unavailable.","view":"asylum"},{"year":2024,"population_type":"STA","text":"Authorities in Uzbekistan confirmed that the number of stateless persons with permanent residence has decreased below 20,000, leading to a revision of the previous statistics as of 31 December 2023. The figures will be reviewed once official data for 2024 becomes available. Information on categories of statelessness, other than stateless persons with permanent residence is unavailable.","view":"asylum"},{"year":2025,"population_type":"REF","text":"At end-2025, 1 million Afghans were, for the first time, reported as other people in need of international protection in five countries. Previously, these Afghans had been reported as people in a refugee-like situation. The reclassification includes 7,700 Afghans in Uzbekistan.","view":"asylum"},{"year":2025,"population_type":"STA","text":"Authorities in Uzbekistan confirmed that the number of stateless persons with permanent residence has decreased to 16,000 by November 2025. The figures will be reviewed once official data becomes available. Information on categories of statelessness, other than stateless persons with permanent residence is unavailable.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
