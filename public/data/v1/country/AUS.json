gees":10,"resettlement":17325,"naturalisation":null,"returned_idps":null},{"year":2023,"returned_refugees":197,"resettlement":15223,"naturalisation":1327,"returned_idps":null},{"year":2024,"returned_refugees":null,"resettlement":17211,"naturalisation":129,"returned_idps":null},{"year":2025,"returned_refugees":1172,"resettlement":18804,"naturalisation":10034,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":12307},{"year":2016,"applied":33470},{"year":2017,"applied":49872},{"year":2018,"applied":42725},{"year":2019,"applied":42251},{"year":2020,"applied":33377},{"year":2021,"applied":28326},{"year":2022,"applied":30918},{"year":2023,"applied":44210},{"year":2024,"applied":20753},{"year":2025,"applied":24581}],"origin":[{"year":2015,"applied":5},{"year":2016,"applied":6},{"year":2017,"applied":23},{"year":2018,"applied":12},{"year":2019,"applied":10},{"year":2020,"applied":10},{"year":2021,"applied":21},{"year":2022,"applied":30},{"year":2023,"applied":46},{"year":2024,"applied":56},{"year":2025,"applied":16}]},"idmc":[],"footnotes":[{"year":null,"population_type":"ASY","text":"Australia’s figures for asylum-seekers are based on the number of applications lodged for protection visas.","view":"asylum"},{"year":null,"population_type":"ASY","text":"Australia's figures for asylum-seekers are based on the number of applications lodged for protection visas.","view":"asylum"},{"year":null,"population_type":"REF","text":"The methodology for estimating the number of refugees in Australia is under review and subject to adjustment in future reports. The asylum-seeker figure is based on the number of applications lodged for protection visas.","view":"asylum"},{"year":null,"population_type":"STA","text":"Stateless figures in Australia are sourced from the Government. They consist of figures on stateless persons held in detention and those that have been issued or are in an application process for an “Onshore Humanitarian Visa” and have self-reported to be stateless. Australia does not have a separate statelessness status determination procedure and only provides statistics on humanitarian visas. Due to this, the figure reported here does not capture all stateless persons in Australia and is not an estimate of statelessness in Australia. Figures for stateless persons in detention come from the Australian Government Department of Home Affairs and Australian Border Force report on Immigration Detention and Community Statistics Summary 31 January 2022.","view":"asylum"},{"year":2020,"population_type":"STA","text":"Stateless figures in Australia are sourced from the Government. They consist of figures on stateless persons held in detention and those that have been issued or are in an application process for an “Onshore Humanitarian Visa” and have self-reported to be stateless. Australia does not have a separate statelessness status determination procedure and only provides statistics on humanitarian visas. Due to this, the figure reported here does not capture all stateless persons in Australia and is not an estimate of statelessness in Australia. Figures for stateless persons in detention come from the Australian Government Department of Home Affairs and Australian Border Force report on Immigration Detention and Community Statistics Summary 31 December 2020.","view":"asylum"},{"year":2022,"population_type":"REF","text":"The methodology for estimating the number of refugees in Australia is under review and subject to adjustment in future reports.","view":"asylum"},{"year":2022,"population_type":"RST","text":"UNHCR is currently engaged in ongoing discussions with the Australian Government about how best to reflect Afghan refugee arrivals. The total number of Afghan refugee resettlement arrivals may change in future reports. Many of the Afghan resettlement arrivals include individuals that arrived in Australia on 449 visas and were subsequently converted to offshore humanitarian visas. As a result, not all of the arrivals may have occurred in 2022.","view":"asylum"},{"year":2023,"population_type":"REF","text":"The number of refugees in Australia has been revised using updated data on the number of residence permit holders with refugee status by the end of 2023, as received from the government.","view":"asylum"},{"year":2023,"population_type":"STA","text":"Stateless figures in Australia are sourced from the Government. They consist of figures on stateless persons held in detention and those that have been issued or are in an application process for an “Onshore Humanitarian Visa” and have self-reported to be stateless. Australia does not have a separate statelessness status determination procedure and only provides statistics on humanitarian visas. Due to this, the figure reported here does not capture all stateless persons in Australia and is not an estimate of statelessness in Australia. Figures for stateless persons in detention come from the Australian Government Department of Home Affairs and Australian Border Force report on Immigration Detention and Community Statistics Summary 31 December 2023.","view":"asylum"},{"year":2024,"population_type":"REF,ROC,ASY,IDP,IOC,STA,OOC,RET,RDP,HST,OIP,RST,NAT","text":"All figures are as of mid-2024 apart from statistics on resettlement arrivals and asylum-seekers.","view":"asylum"},{"year":2024,"population_type":"STA","text":"Stateless figures in Australia are sourced from the Government. They consist of figures on stateless persons held in detention and those that have been issued or are in an application process for an “Onshore Humanitarian Visa” and have self-reported to be stateless. Australia does not have a separate statelessness status determination procedure and only provides statistics on humanitarian visas. Due to this, the figure reported here does not capture all stateless persons in Australia and is not an estimate of statelessness in Australia. Figures for stateless persons in detention come from the Australian Government Department of Home Affairs and Australian Border Force report on Immigration Detention and Community Statistics Summary 31 December 2024. As updated data for some stateless populations were not yet available, some of the figures only reflect information received until mid-2024.","view":"asylum"},{"year":2025,"population_type":"STA","text":"Stateless figures in Australia are sourced from the Government. They consist of figures on stateless persons held in detention and those that have been issued or are in an application process for an “Onshore Humanitarian Visa” and have self-reported to be stateless. Australia does not have a separate statelessness status determination procedure and only provides statistics on humanitarian visas. Due to this, the figure reported here does not capture all stateless persons in Australia and is not an estimate of statelessness in Australia. Figures for stateless persons in detention come from the Australian Government Department of Home Affairs and Australian Border Force report on Immigration Detention and Community Statistics Summary 31 December 2025.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
