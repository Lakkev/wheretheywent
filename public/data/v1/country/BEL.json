s":null},{"year":2017,"returned_refugees":null,"resettlement":1309,"naturalisation":1918,"returned_idps":null},{"year":2018,"returned_refugees":null,"resettlement":880,"naturalisation":null,"returned_idps":null},{"year":2019,"returned_refugees":null,"resettlement":239,"naturalisation":2397,"returned_idps":null},{"year":2020,"returned_refugees":null,"resettlement":176,"naturalisation":null,"returned_idps":null},{"year":2021,"returned_refugees":null,"resettlement":963,"naturalisation":null,"returned_idps":null},{"year":2022,"returned_refugees":4000,"resettlement":71,"naturalisation":null,"returned_idps":null},{"year":2023,"returned_refugees":4000,"resettlement":287,"naturalisation":null,"returned_idps":null},{"year":2024,"returned_refugees":null,"resettlement":455,"naturalisation":null,"returned_idps":null},{"year":2025,"returned_refugees":null,"resettlement":40,"naturalisation":981,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":44717},{"year":2016,"applied":18683},{"year":2017,"applied":18930},{"year":2018,"applied":22550},{"year":2019,"applied":12879},{"year":2020,"applied":16881},{"year":2021,"applied":24470},{"year":2022,"applied":43712},{"year":2023,"applied":44445},{"year":2024,"applied":46583},{"year":2025,"applied":46920}],"origin":[{"year":2015,"applied":26},{"year":2016,"applied":12},{"year":2017,"applied":15},{"year":2018,"applied":68},{"year":2019,"applied":73},{"year":2020,"applied":44},{"year":2021,"applied":53},{"year":2022,"applied":36},{"year":2023,"applied":95},{"year":2024,"applied":76},{"year":2025,"applied":37}]},"idmc":[],"footnotes":[{"year":null,"population_type":"STA","text":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government.","view":"asylum"},{"year":2018,"population_type":"REF","text":"Refugee figure related to the end of 2016.","view":"asylum"},{"year":2018,"population_type":"REF","text":"The refugee figure relates to the end of 2016.","view":"asylum"},{"year":2019,"population_type":"ASY","text":"Source: Eurostat","view":"asylum"},{"year":2020,"population_type":"STA","text":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government. UNHCR no longer reports on the number of persons registered by the Belgian Government in the national register under categories such as “undetermined nationality” and “nationality not yet determined” as the definitions of these categories are broad and may encompass other groups than stateless persons.","view":"asylum"},{"year":2021,"population_type":"REF,ROC,ASY,IDP,IOC,STA,OOC,RET,RDP,HST,OIP,RST,NAT","text":"The data is based on the registered population as of end-2020, as data for 2021 was not available at time of publication apart from the data on asylum-seekers, which was sourced from Eurostat, and resettlement which was sourced from the Federal Agency for the Reception of Asylum Seekers.","view":"asylum"},{"year":2021,"population_type":"STA","text":"Belgium includes a 'stateless' category in its National Registry, which records people who have been recognised as stateless and issued long-term residence permits in Belgium. There are also stateless people who are not counted in the National Registry data, for example, people awaiting determination of their statelessness, people recognised as stateless but not granted a residence permit, stateless people holding a short-term residence permit, and stateless people in the asylum procedure.","view":"asylum"},{"year":2023,"population_type":"RST","text":"The number of resettlement arrivals is based on available figures of UNHCR facilitated resettlement departures to Belgium.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
