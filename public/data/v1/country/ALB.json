02,"returned_refugees":16,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2003,"returned_refugees":5,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2004,"returned_refugees":5,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2008,"returned_refugees":6,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2022,"returned_refugees":5,"resettlement":null,"naturalisation":null,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":590},{"year":2016,"applied":2176},{"year":2017,"applied":299},{"year":2018,"applied":4352},{"year":2019,"applied":64},{"year":2020,"applied":12},{"year":2021,"applied":15},{"year":2022,"applied":29},{"year":2023,"applied":28},{"year":2024,"applied":16},{"year":2025,"applied":36}],"origin":[{"year":2015,"applied":72743},{"year":2016,"applied":37505},{"year":2017,"applied":35970},{"year":2018,"applied":32512},{"year":2019,"applied":29729},{"year":2020,"applied":14161},{"year":2021,"applied":19573},{"year":2022,"applied":35556},{"year":2023,"applied":16663},{"year":2024,"applied":13686},{"year":2025,"applied":9566}]},"idmc":[],"footnotes":[{"year":null,"population_type":"STA","text":"The statelessness figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011-2017.","view":"asylum"},{"year":null,"population_type":"STA","text":"From various sources such as civil status offices, health institutions, schools, municipal child protection units, and social services, UNHCR estimates the number of people with undetermined nationality (at risk of statelessness) in Albania.","view":"asylum"},{"year":2015,"population_type":"STA","text":"Figure refers to a census from 2011 and is currently under review.","view":"asylum"},{"year":2016,"population_type":"STA","text":"The statelessness figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011-2016.","view":"asylum"},{"year":2016,"population_type":"STA","text":"Figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011-2016.","view":"asylum"},{"year":2017,"population_type":"STA","text":"Figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011-2017.","view":"asylum"},{"year":2018,"population_type":"STA","text":"Figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011-2018.","view":"asylum"},{"year":2019,"population_type":"STA","text":"The statelessness figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011-2019.","view":"asylum"},{"year":2020,"population_type":"STA","text":"The statelessness figure refers to a census from 2011 and has been adjusted to reflect the number of persons with undetermined nationality who had their nationality confirmed in 2011- 2020.","view":"asylum"},{"year":2021,"population_type":"STA","text":"From various sources such as civil status offices, health institutions, schools, municipal child protection units, and social services, UNHCR estimates the number of people with undetermined nationality (at risk of statelessness).","view":"asylum"},{"year":2022,"population_type":"STA","text":"From various sources such as civil status offices, health institutions, schools, municipal child protection units, and social services, UNHCR estimates the number of people with undetermined nationality (at risk of statelessness). The start-year figures are based on an identification exercise conducted in 2021 which identified a further 1,120 persons at risk of statelessness, subtracting the number of undocumented persons who had their nationality confirmed by the Albanian authorities in 2021. During 2022, an additional 350 people were assisted to confirm their nationalities through administrative and/or judicial procedures, out of which 238 were fully resolved.","view":"asylum"},{"year":2023,"population_type":"STA","text":"The Albanian Government conducted the Population and Housing Census during the period of September–October 2023. The results of the census are expected to be published by the end of June 2024 and the number of persons at risk of statelessness identified will be updated accordingly.\r\r\n\r\r\nThe start-year figures are based on an identification exercise conducted in 2021 which identified a further 1,120 persons at risk of statelessness, subtracting the number of undocumented persons who had their nationality confirmed by the Albanian authorities in 2021. During 2022, an additional 350 people were assisted to confirm their nationalities through administrative and/or judicial procedures, out of which 238 were fully resolved.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
