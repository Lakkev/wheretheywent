rned_refugees":4626,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2024,"returned_refugees":4707,"resettlement":null,"naturalisation":null,"returned_idps":null},{"year":2025,"returned_refugees":17486,"resettlement":null,"naturalisation":null,"returned_idps":null}],"asylum_applications":{"host":[{"year":2015,"applied":15975},{"year":2016,"applied":18244},{"year":2017,"applied":19764},{"year":2018,"applied":19481},{"year":2019,"applied":12886},{"year":2020,"applied":5543},{"year":2021,"applied":11602},{"year":2022,"applied":16504},{"year":2023,"applied":92937},{"year":2024,"applied":88027},{"year":2025,"applied":32718}],"origin":[{"year":2015,"applied":1266},{"year":2016,"applied":1031},{"year":2017,"applied":1112},{"year":2018,"applied":2050},{"year":2019,"applied":1656},{"year":2020,"applied":977},{"year":2021,"applied":1732},{"year":2022,"applied":2512},{"year":2023,"applied":8733},{"year":2024,"applied":5638},{"year":2025,"applied":3068}]},"idmc":[{"year":2009,"total":250000},{"year":2010,"total":250000},{"year":2011,"total":250000},{"year":2012,"total":300000},{"year":2013,"total":412000},{"year":2014,"total":309000},{"year":2015,"total":309000},{"year":2016,"total":138000},{"year":2017,"total":159000},{"year":2018,"total":162000},{"year":2019,"total":162000},{"year":2020,"total":190000},{"year":2021,"total":190000},{"year":2022,"total":30000},{"year":2023,"total":38000},{"year":2024,"total":100000},{"year":2025,"total":10000}],"footnotes":[{"year":null,"population_type":"STA","text":"The figure is based on an estimate of 18,500 in 2019 by UNHCR with input from stateless communities, taking account of the registration by the Government of Kenya in 2020 of 1,670 stateless persons of Shona descent. These individuals were granted Kenyan citizenship in 2021.","view":"asylum"},{"year":null,"population_type":"STA","text":"The figure of 20,000 is an estimate by UNHCR and civil society organizations based on currently available information on several communities in Kenya. This estimate is under review pending further research and mapping activities.","view":"asylum"},{"year":2017,"population_type":"STA","text":"The figure of 18,500 is an estimate by UNHCR and civil society organizations based on currently available information on several communities in Kenya.","view":"asylum"},{"year":2018,"population_type":"STA","text":"The figure of 18,500 is an estimate by UNHCR with input from stateless communities.","view":"asylum"},{"year":2019,"population_type":"STA","text":"The figure of 18,500 is an estimate by UNHCR with input from stateless communities. The stateless population figures will be further reviewed in 2020 taking into consideration results from the 2019 Population and Housing Census conducted by the Government of Kenya as well as several studies on stateless populations undertaken over the last few years.","view":"asylum"},{"year":2020,"population_type":"STA","text":"The figure of 18,500  in 2019 was an estimate by UNHCR with input from stateless communities. In December 2020 the Government of Kenya registered 1,670 stateless persons of Shona descent as citizens of Kenya putting an end to their statelessness situation. This brings the total estimated statelessness population down to 16,830.","view":"asylum"},{"year":2023,"population_type":"STA","text":"The figure is based on an estimate of 18,500 in 2019 by UNHCR with input from stateless communities of whom 1,670 stateless persons of Shona descent were granted Kenyan citizenship in 2020. In 2022 approximately 7,000 individuals from the Pemba community had their nationality confirmed.","view":"asylum"},{"year":2024,"population_type":"STA","text":"The figure is based on an estimate of 18,500 in 2019 by UNHCR with input from stateless communities of whom 1,670 stateless persons of Shona descent were granted Kenyan citizenship in 2020. In 2023, approximately 7,000 individuals from the Pemba community had their nationality confirmed. An official government report on the Pemba registration exercise is yet to be released and statistics will be updated accordingly. As of end-2024, the figure of 9,800 stateless persons in Kenya remains an estimate.","view":"asylum"},{"year":2025,"population_type":"STA","text":"The figure is based on an estimate of 18,500 in 2019 by UNHCR with input from stateless communities of whom 1,670 stateless persons of Shona descent were granted Kenyan citizenship in 2020. In 2023, approximately 7,000 individuals from the Pemba community had their nationality confirmed. An official government report on the Pemba registration exercise is yet to be released and statistics will be updated accordingly. As of 2025, the figure of 9,800 stateless persons in Kenya remains an estimate.","view":"asylum"}],"sources":["unhcr_countries","unhcr_population","unhcr_demographics","unhcr_idmc","unhcr_solutions","unhcr_asylum_applications","unhcr_footnotes","wpp_population","natural_earth"]}
