# Basemap style URL (OpenFreeMap positron by default). Override to swap basemap provider.
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Public site URL (used for permalinks / citations / JSON-LD)
PUBLIC_SITE_URL=https://wheretheywent.lakkev.com
# Project contact e-mail (About page + error reporting). Use a project-dedicated mailbox.
PUBLIC_CONTACT_EMAIL=contact@example.org
